{
  "name": "smartpos-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SmartPOS Desktop — Point of Sale for Kenyan Businesses",
  "main": "electron/main.js",
  "author": {
    "name": "Davis Okoth",
    "email": "davismcintyre5@gmail.com"
  },
  "publisher": "HDM",
  "owner": "Davis Okoth",
  "company": "HDM",
  "license": "ISC",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "assets": "node scripts/generate-assets.cjs",
    "electron:dev": "npm run build && electron .",
    "electron:hot": "concurrently \"vite --port 3000\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "electron:start": "electron .",
    "electron:build": "npm run assets && vite build && electron-builder --publish always",
    "electron:build:win": "npm run assets && vite build && electron-builder --win --publish always",
    "electron:build:local": "npm run assets && vite build && electron-builder --publish never",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\"",
    "release:push": "git push --follow-tags"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "axios": "^1.7.7",
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.451.0",
    "node-thermal-printer": "^4.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^7.2.0"
  }
}