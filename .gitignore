# ── Dependencies ──────────────────────────────────────────
node_modules/
jspm_packages/
bower_components/

# ── Environment ───────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example
!.env.sample

# ── Logs ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pino-*.log

# ── Build output ──────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
.vercel/
.netlify/

# ── Caches ────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.node_repl_history
.npm
.yarn/cache
.yarn/unplugged
.pnp.*
.pnp.js

# ── Test / coverage ───────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Database / backups ────────────────────────────────────
backups/
*.sqlite
*.sqlite3
*.db
dump/
mongodump/

# ── Uploads / temp ────────────────────────────────────────
uploads/
tmp/
temp/
*.tmp

# ── Editor / IDE ──────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS files ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Electron ──────────────────────────────────────────────
dist_electron/
release/
*.dmg
*.AppImage
*.snap
*.exe
*.msi
*.deb
*.rpm

# ── Docker ────────────────────────────────────────────────
docker-compose.override.yml

# ── Misc ──────────────────────────────────────────────────
.eslintcache
*.pid
*.seed
*.pid.lock
lib-cov/
.grunt/
.lock-wscript/
.node_repl_history
