    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo",
    "seed:reset": "node scripts/seed.js --reset",
    "admin": "node scripts/admin.js",
    "backup": "node scripts/backup.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
 "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.6.0",
    "dotenv": "^16.4.5",

    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "argon2": "^0.41.1",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.6",

    "zod": "^3.23.8",

    "stripe": "^16.9.0",
    "@paypal/paypal-server-sdk": "^0.6.0",
    "axios": "^1.7.7",

    "cloudinary": "^2.5.1",
